# Where the frontend finds the backend (defaults to http://localhost:8000).
VITE_API_URL=http://localhost:8000
# The dev-only "load every stock" test button is shown while running npm run dev (never in a production build).
# It also needs DEV_TOOLS=1 in the backend .env. Set to 0 to hide it.
# VITE_DEV_TOOLS=0
